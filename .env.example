# Firebase — העתיקו ל-.env.local ומלאו מ-Firebase Console → Project settings → Your apps
# בלי הקובץ הזה האפליקציה רצה במצב דמו מקומי (נתונים על המכשיר בלבד, בלי שיתוף)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini (אופציונלי) — "סריקה חכמה" של פוליסות ביטוח עם זיהוי AI במקום OCR מקומי.
# בלי מפתח, הסריקה עובדת עם Tesseract במכשיר. חשוב: המפתח נחשף בצד לקוח —
# הגבילו אותו ב-Google Cloud Console (Referrer לדומיין האפליקציה + Generative Language API בלבד).
VITE_GEMINI_API_KEY=
# ברירת מחדל gemini-2.0-flash; אפשר לשנות למשל ל-gemini-2.5-flash
VITE_GEMINI_MODEL=
