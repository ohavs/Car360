rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // photos of a car: only its owner and the people it is shared with may
    // write or delete them. Reading goes through the download URL's token.
    function car(carId) {
      return firestore.get(/databases/(default)/documents/cars/$(carId)).data;
    }
    function canAccess(carId) {
      return request.auth != null && (
        car(carId).ownerId == request.auth.uid ||
        (request.auth.token.email != null && car(carId).sharedWith.hasAny([request.auth.token.email]))
      );
    }
    // a brand-new car's photo is uploaded before the car itself is saved
    function isNewCar(carId) {
      return request.auth != null && !firestore.exists(/databases/(default)/documents/cars/$(carId));
    }

    match /cars/{carId}/{allPaths=**} {
      allow read: if request.auth != null;
      // images are uploaded pre-compressed (~100-350KB); cap at 2MB as safety
      allow create, update: if (canAccess(carId) || isNewCar(carId))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canAccess(carId);
    }
  }
}
