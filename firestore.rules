rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function canAccessCar(car) {
      return isSignedIn() && (
        car.ownerId == request.auth.uid ||
        (request.auth.token.email != null && car.sharedWith.hasAny([request.auth.token.email]))
      );
    }

    function canAccessCarId(database, carId) {
      return canAccessCar(get(/databases/$(database)/documents/cars/$(carId)).data);
    }

    // per-user profile, design preferences & FCM push tokens
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // public, read-only car passports — anyone with the (unguessable) token
    // may read; only signed-in users can publish or revoke a link.
    match /publicPassports/{token} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cars/{carId} {
      allow read: if canAccessCar(resource.data);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // owner can do anything; shared users may update everything except ownership & sharing
      allow update: if canAccessCar(resource.data) && (
        resource.data.ownerId == request.auth.uid ||
        (request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.sharedWith == resource.data.sharedWith)
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read, write: if canAccessCarId(database, carId);
      }
    }
  }
}
